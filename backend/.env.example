# TP全屋家居官网 后端环境变量示例（技术文档 §2.4）
# 复制为 .env 后按需修改；生产环境强制校验（APP_ENV=prod 时 JWT 密钥与 PG 库）

# ---- 运行环境 ----
APP_ENV=dev                                  # dev / test / prod
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- 数据库（双环境切换核心，ADR-002）----
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://tp_user:tp_pass@localhost:5432/tp_home

# ---- JWT（PRD 6.7.1：access ≤24h / refresh 30d）----
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- 文件存储（PRD 7.0）----
UPLOAD_DIR=./uploads
STATIC_URL=/static
MAX_IMAGE_SIZE_MB=5
MAX_FILE_SIZE_MB=10

# ---- 短信（预留抽象，R4 降级）----
SMS_PROVIDER=mock                             # mock / aliyun / tencent
SMS_SIGN_NAME=TP全屋家居
SMS_TEMPLATE_CODE=SMS_123456
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# ---- 地图（门店标注，R5 降级）----
MAP_PROVIDER=amap                             # amap / tencent
MAP_JS_KEY=

# ---- Redis（可选，缺失自动降级）----
REDIS_URL=

# ---- 系统初始化（PRD §11.2）----
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123
